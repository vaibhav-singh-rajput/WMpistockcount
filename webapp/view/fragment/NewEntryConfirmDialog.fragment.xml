<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog id="confirmDialog" draggable="true" resizable="true" title="Confirm Items" contentWidth="80%" contentHeight="60%" stretchOnPhone="true">

        <VBox width="100%" renderType="Bare">
            <Table id="idConfirmTable" inset="false" items="{confirmModel>/items}" autoPopinMode="true" sticky="ColumnHeaders">

                <columns>
                    <Column>
                        <Text text="Material"/>
                    </Column>
                    <Column>
                        <Text text="Plant"/>
                    </Column>
                    <!-- <Column>
                        <Text text="Storage Loc."/>
                    </Column> -->
                    <Column>
                        <Text text="Batch"/>
                    </Column>
                    <Column>
                        <Text text="Bin"/>
                    </Column>
                    <Column>
                        <Text text="Storage Type"/>
                    </Column>
                    <Column importance="High">
                        <Text text="Counted Quantity"/>
                    </Column>
                    <Column>
                        <Text text="UOM"/>
                    </Column>
                    <!-- <Column>
                        <Text text="Inventory Page"/>
                    </Column> -->
                    <!-- <Column>
                        <Text text="GR Date"/>
                    </Column> -->
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <!-- <Text text="{confirmModel>Ivpos}" /> -->
                            <Text text="{confirmModel>Matnr}" />
                            <Text text="{confirmModel>Werks}" />
                            <!-- <Text text="{confirmModel>LGORT}" class="highlightColumn" /> -->
                            <Text text="{confirmModel>Batch}" />
                            <Text text="{confirmModel>Lgpla}" />
                            <Text text="{confirmModel>Lgtyp}" />
                            <Text text="{confirmModel>CountedQty}" class="highlightColumn" />
                            <Text text="{confirmModel>Meins}" />
                            <!-- <Text text="{confirmModel>GrDate}" /> -->
                        </cells>
                    </ColumnListItem>

                </items>

            </Table>
        </VBox>

        <beginButton>
            <Button text="OK" type="Accept" press=".onConfirmOk" />
        </beginButton>

        <endButton>
            <Button text="Cancel" press=".onConfirmCancel" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>